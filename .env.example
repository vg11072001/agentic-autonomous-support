# copy to .env and fill in.

# CockroachDB cloud connection string (Standard/Advanced, v25.2+ for VECTOR)
# Get it from the Cloud Console -> Connect. Keep sslmode=verify-full
CRDB_URL=postgresql://user:pass@your-cluster.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full
PG_CHECKPOINT_URL=postgresql://user:pass@real-postgres-host:5432/checkpoints
QDRANT_URL=http://localhost:6333

# ---- AWS ----
# Standard AWS credential chain is used (env vars, ~/.aws, or an IAM role).
# For local dev you can set keys here; in production prefer an IAM role.
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BEARER_TOKEN_BEDROCK=

# Bedrock model for reasoning (Resolution agent, tier-2 guardrail, judge,
# simulator, KB drafter). Must be enabled in your Bedrock console/region.
BEDROCK_MODEL_ID=us.meta.llama3-3-70b-instruct-v1:0
BEDROCK_ENABLED=1
# Set to 0 to force deterministic offline mode (CI / no-AWS demos).
BEDROCK_ENABLED=1

# S3 bucket holding KB policy docs (used by the Lambda embedder, script 22).
KB_BUCKET=auto-support-system

# To access gemini model as llm pass following parater for reasoning
DEFAULT_MODEL_ID = gemini-3.5-flash-lite
# GEMINI_API_KEY = 
GEMINI_ENABLED = 1
GEMINI_RPD_LIMIT = 500
GEMINI_RPM_LIMIT = 15
GEMINI_MIN_INTERVAL_S = 2

# To access firewall on llm grant this as 1
FIREWALL_LLM = 1